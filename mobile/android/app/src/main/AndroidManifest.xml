<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SANS CETTE LIGNE, L'APK DE PRODUCTION NE JOINT RIEN.
         `flutter create` ne déclare INTERNET que dans les manifestes `debug` et
         `profile`, où l'outil en a besoin pour le rechargement à chaud. Le
         manifeste `main`, seul retenu dans une compilation `release`, n'en a
         aucune. L'application se lançait donc parfaitement en débogage et
         l'APK distribué échouait sur chaque appel à Supabase, avec pour tout
         message une erreur réseau. Vérification : `aapt2 dump permissions`. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- La position du livreur. `COARSE` accompagne `FINE` parce qu'Android 12
         et suivants laissent l'utilisateur n'accorder que l'approximative :
         sans elle déclarée, ce choix rend une permission refusée au lieu d'une
         position dégradée, et le livreur ne voit plus aucune course. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Suivi pendant la course, téléphone en poche. Elle se demande séparément
         et APRÈS l'accord de premier plan : Android 11 et suivants refusent
         sèchement une demande groupée. Voir `lib/features/livreur/suivi_position.dart`. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Le service de premier plan, seul moyen légitime de continuer à
         localiser écran éteint. `FOREGROUND_SERVICE_LOCATION` est exigée à
         partir d'Android 14, et son absence fait planter le démarrage du
         service au lieu de le dégrader. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- La notification persistante du service. Obligatoire depuis Android 13,
         et c'est elle qui rend le suivi visible et honnête pour le livreur :
         il voit qu'il est suivi, et peut arrêter. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Le réseau ivoirien est irrégulier. L'application doit savoir qu'elle est
         hors ligne pour le dire, plutôt que d'attendre un délai d'expiration. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- « Yalla », pas « yalla_mobile » : c'est ce que le boutiquier lit sous
         l'icône, sur son écran d'accueil, à côté de WhatsApp et d'Orange Money. -->
    <application
        android:label="Yalla"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Depuis Android 11, une application ne voit pas les autres sans les
             déclarer ici. `canLaunchUrl` rendait donc faux pour `tel:` et
             `geo:` alors que le téléphone et la carte étaient bien installés :
             le livreur ne pouvait ni appeler la boutique ni ouvrir
             l'itinéraire, les deux seules actions qui le sortent de
             l'application pendant une course. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
