# Copiez ce fichier vers backend/.env et renseignez les valeurs.
# Ne committez JAMAIS le .env réel.

# ── Base de données (PostgreSQL + PostGIS) ────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=yalla

# ── Authentification ──────────────────────────────────────────────────────
# Générez une valeur aléatoire : openssl rand -hex 32
JWT_SECRET=changeme-secret-de-developpement-uniquement
JWT_EXPIRATION=7d

# ── Serveur ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Intégrations déclarées mais non branchées ─────────────────────────────
# Décommentez au moment de les implémenter (voir AGENTS.md §7).
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# FCM_SERVER_KEY=
